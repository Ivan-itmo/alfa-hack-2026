# Server
SERVER_ADDR=0.0.0.0
SERVER_PORT=8080
PORT=8080
GIN_MODE=release

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=alfa
DB_PASSWORD=alfa_2026
DB_NAME=alfa_credit
DB_SSLMODE=disable

# JWT Authentication (min 32 bytes)
JWT_SECRET=local-demo-only-change-this-secret-32-bytes

# AI API (OpenAI-compatible, e.g. Ollama / Gemma)
AI_BASE_URL=http://10.154.0.1:8080/v1
AI_MODEL=gemma4:12b
AI_API_KEY=
AI_TIMEOUT=30

# ML scoring service base URL (empty = demo rules; HTTP timeout 4s)
# В docker-compose бэкенд обращается к сервису по имени контейнера.
SCORING_BASE_URL=http://scoring:8000
SCORING_PORT=8000
# Бюджет LLM внутри сервиса скоринга (должен быть < 4с таймаута Go-клиента)
SCORING_AI_TIMEOUT=2.5
DSTI_APPROVE_MAX=0.35
DSTI_COUNTER_MAX=0.55
